# ─────────────────────────────────────────────────────────────
# Stellar Unified Price Oracle — Frontend environment variables
# Copy this file to .env and fill in values for local dev.
# Never commit .env to version control.
# See docs/env.md for full documentation of every variable.
# ─────────────────────────────────────────────────────────────

# ── API ──────────────────────────────────────────────────────

# Base URL for the REST API.
# The dev server proxies /api/* to this origin.
# In production point this at the deployed Aggregator API.
# Type: string (URL)  Default: /api  Required: yes
VITE_API_URL=http://localhost:3000

# WebSocket endpoint for real-time price updates (/ws).
# The dev server proxies /ws to this origin with ws:true.
# Type: string (WebSocket URL)  Default: ws://localhost:3000  Required: yes
VITE_WS_URL=ws://localhost:3000

# URL of the backend OpenAPI spec used by `npm run generate:openapi`.
# Only needed when regenerating the TypeScript API types — leave blank otherwise.
# Type: string (URL)  Default: ""  Required: no
VITE_OPENAPI_SPEC_URL=

# ── On-chain ─────────────────────────────────────────────────

# Soroban network the on-chain comparison panel reads from.
# Type: "mainnet" | "testnet" | "futurenet"  Default: testnet  Required: no
VITE_ORACLE_NETWORK=testnet

# JSON override of the contract registry (see src/lib/contractRegistry.ts) for
# local/test deployments, e.g. {"testnet":{"XLM":"C...LOCAL_CONTRACT_ID"}}.
# Leave blank to use the built-in registry.
# Type: string (JSON)  Default: ""  Required: no
VITE_ORACLE_CONTRACT_OVERRIDES=

# ── Analytics ────────────────────────────────────────────────

# Endpoint for Web Vitals / custom analytics events.
# Leave blank to disable analytics reporting entirely.
# Type: string (URL)  Default: ""  Required: no
VITE_ANALYTICS_URL=

# ── Features ─────────────────────────────────────────────────

# Enable MSW mock service worker in the browser.
# Set to "true" to run the app against mock API responses
# without a real backend.  Auto-enabled in Vitest.
# Type: "true" | "false"  Default: "false"  Required: no
VITE_USE_MOCK=false

# ── Debug ────────────────────────────────────────────────────

# Override log verbosity.  Accepted values: "debug" | "info" | "warn" | "error"
# Defaults to "warn" in production and "debug" in development.
# Type: "debug" | "info" | "warn" | "error"  Default: "warn"  Required: no
VITE_LOG_LEVEL=debug

# ── Sentry (error tracking) ───────────────────────────────────
# These variables are optional and only consumed server-side in CI
# (see .github/workflows/ci.yml).  They are listed here for reference.
#
# SENTRY_AUTH_TOKEN=<token>  (CI secret — never put in .env)
# SENTRY_ORG=<org-slug>      (CI secret — never put in .env)
# SENTRY_PROJECT=<project>   (CI secret — never put in .env)
